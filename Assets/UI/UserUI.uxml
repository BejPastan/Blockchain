<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainStyle.uss?fileID=7433441132597879392&amp;guid=d0036ac7f68dc4b4dade18015e9a56a8&amp;type=3#MainStyle"/>
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="userData" style="flex-grow: 1;">
            <ui:VisualElement name="userDetails" style="flex-grow: 1; height: 96px; flex-direction: column;">
                <ui:VisualElement class="infoContainer">
                    <ui:Label text="Money" name="label" style="font-size: 24px;"/>
                    <ui:Label text="Label" name="moneyLabel" data-source="project://database/Assets/Settings/UserUIData.asset?fileID=11400000&amp;guid=37ac807ebee91b447a9c0600a02ff17f&amp;type=2#UserUIData" style="font-size: 32px;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="_moneyText" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="infoContainer">
                    <ui:Label text="Wallet" name="label" style="font-size: 24px;"/>
                    <ui:Label text="Label" name="walletAddress" data-source="project://database/Assets/Settings/UserUIData.asset?fileID=11400000&amp;guid=37ac807ebee91b447a9c0600a02ff17f&amp;type=2#UserUIData" style="font-size: 16px;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="_walletText" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tokensList" style="flex-grow: 1;">
                <ui:Label text="Your Tokens" name="tokensHeader" style="font-size: 20px; unity-text-align: center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="actions" style="flex-grow: 1;">
            <ui:Button text="MintNew" name="mintButton"/>
            <ui:TextField label="Text Field" placeholder-text="filler text" name="tokenPrice" data-source="project://database/Assets/Settings/UserUIData.asset?fileID=11400000&amp;guid=37ac807ebee91b447a9c0600a02ff17f&amp;type=2#UserUIData" value="100" style="flex-direction: column;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="newTokenPrice" binding-mode="ToSource"/>
                </Bindings>
            </ui:TextField>
            <ui:Button text="Change Price" name="changePrice"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
